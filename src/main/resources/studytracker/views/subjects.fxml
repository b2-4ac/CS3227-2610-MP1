<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="22.0" styleClass="content-page" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="studytracker.ui.SubjectViewController">
    <padding>
        <Insets bottom="32.0" left="32.0" right="32.0" top="30.0" />
    </padding>
    <children>
        <VBox spacing="4.0">
            <Label text="Subjects" styleClass="page-title" />
            <Label text="Create and manage the subjects you are currently studying." styleClass="page-description" />
        </VBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="section-card">
            <children>
                <TextField fx:id="newSubjectNameField" promptText="New subject name" HBox.hgrow="ALWAYS" />
                <Button fx:id="addSubjectButton" mnemonicParsing="false" onAction="#addSubject" text="Add subject" styleClass="primary-action" />
            </children>
        </HBox>
        <VBox spacing="10.0" styleClass="section-card" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT">
                <children>
                    <VBox spacing="3.0">
                        <Label text="Your subjects" styleClass="section-title" />
                        <Label text="Select a subject to remove it from future timer choices." styleClass="section-description" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="deleteSubjectButton" disable="true" mnemonicParsing="false" onAction="#deleteSelectedSubject" text="Delete selected" styleClass="danger-action" />
                </children>
            </HBox>
            <TableView fx:id="subjectsTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="subjectNameColumn" prefWidth="600.0" text="Subject" />
                </columns>
                <placeholder>
                    <Label text="Add your first subject to begin tracking study time." styleClass="table-placeholder" />
                </placeholder>
            </TableView>
        </VBox>
    </children>
</VBox>
